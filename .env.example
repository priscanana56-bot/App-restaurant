# =============================================================================
# Modèle de configuration locale — À COPIER VERS `.env`
# -----------------------------------------------------------------------------
# 1) cp .env.example .env
# 2) Renseigner les valeurs utiles en développement.
# 3) Ne JAMAIS committer le fichier `.env` (il est ignoré par Git).
#
# IMPORTANT — SÉCURITÉ :
# Ce fichier est embarqué dans le bundle de l'application. Il ne doit contenir
# QUE des valeurs publiques (URL d'API, drapeaux de fonctionnalité). Une clé
# « secrète » (service_role, clé de paiement, token privé) placée ici serait
# extractible du binaire : elle doit rester côté serveur (Edge Function, API).
#
# Les valeurs peuvent aussi être injectées au build, sans fichier :
#   flutter run --dart-define=API_BASE_URL=https://api.exemple.bf
# La priorité est donnée à `--dart-define` (voir `AppConfig`).
# =============================================================================

# URL de base de l'API distante (vide = mode 100 % local / seed embarqué).
API_BASE_URL=

# Délai maximal d'une requête réseau, en secondes (1 à 60).
API_TIMEOUT_SECONDS=15

# Active la synchronisation distante (true/false). false = offline-first strict.
ENABLE_REMOTE_SYNC=false

# Numéro de support de l'application, au format international E.164.
# Valeur de démonstration à remplacer par le numéro réel avant production.
APP_SUPPORT_PHONE=+22600000000

# Version minimale du schéma de cache local (migration des données Hive).
CACHE_SCHEMA_VERSION=2
